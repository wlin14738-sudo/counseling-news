# ---- Database (PostgreSQL) ----
# Use Supabase / Neon free tier. Get the connection string from your project.
# Local dev can use the same (or a separate) database.
DATABASE_URL="postgresql://user:pass@host:5432/db?sslmode=require"

# ---- Auth ----
# Long random string used to sign admin session cookies.
AUTH_SECRET=""
# Secret required by Vercel Cron (sent as Authorization: Bearer <CRON_SECRET>).
CRON_SECRET=""

# ---- Public site ----
NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# ---- AI (OpenAI) ----
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# ---- Youdao translation (有道智云) ----
# When set, the article title & excerpt are translated via Youdao.
# When empty, the app falls back to OpenAI, then to the original text.
YOUDAO_APP_KEY=""
YOUDAO_APP_SECRET=""

# ---- Translation provider (optional) ----
# mymemory -> free, no key (uses MyMemory, daily quota)
# youdao   -> requires YOUDAO_APP_KEY / YOUDAO_APP_SECRET
# openai   -> requires OPENAI_API_KEY
# empty    -> auto (Youdao if keys, else OpenAI if key, else original)
TRANSLATOR="mymemory"

# ---- Email (Resend) ----
RESEND_API_KEY=""
EMAIL_FROM="Counseling News <newsletter@your-domain.com>"

# ---- Seeded admin ----
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="changeme123"

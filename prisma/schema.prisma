generator client {
  provider = "prisma-client-js"
}

// PostgreSQL (Supabase / Neon) for both local dev and production.
// The models are provider-agnostic (no enums), so switching back to SQLite
// is a one-line change if you ever need a local file-based database.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Source {
  id            Int       @id @default(autoincrement())
  name          String
  nameZh        String    @default("")
  rssUrl        String    @unique
  lang          String    @default("en")
  enabled       Boolean   @default(true)
  dailyLimit    Int       @default(10)
  defaultCategory String  @default("industry")
  lastFetchedAt DateTime?
  articles      Article[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([enabled])
}

model Article {
  id          Int      @id @default(autoincrement())
  sourceId    Int
  source      Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  url         String   @unique
  title       String
  titleZh     String   @default("")
  summary     String   @default("")
  summaryZh   String   @default("")
  content     String   @default("")
  contentZh   String   @default("")
  author      String   @default("")
  category    String   @default("")
  keywords    String   @default("")
  publishedAt DateTime @default(now())
  fetchedAt   DateTime @default(now())
  // "draft" | "published" | "rejected"
  status      String   @default("draft")
  aiConfidence Float   @default(0)
  readCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([publishedAt])
  @@index([sourceId])
}

model Subscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  token     String   @unique
  confirmed Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Admin {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  name         String   @default("admin")
  role         String   @default("admin")
  createdAt    DateTime @default(now())
}
